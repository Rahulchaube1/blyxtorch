fn btx_eval(p: vector, path: str, mode: str) {
    let labelled=mode!="predict";
    let lines=btx_read(path,labelled);
    let mut total=0.0; let mut pass=0;
    // Validate the complete report before writing its header or rows to stdout.
    while pass<2 {
        if pass==1 && mode=="predict" { println!(btx_names("prediction",bt_outputs())); }
        if pass==1 && mode=="gradient" { println!(text_concat("loss,",btx_names("g",bt_parameters()))); }
        let mut row=1;
        while row<args_len(lines) {
            let f=btx_fields(lines,row,labelled); let x=bt_parse_x(f,0);
            let mut out=[];
            if mode=="score" { out=bt_sample_loss(p,x,bt_parse_t(f,bt_inputs())); }
            else if labelled { out=bt_loss_grad(p,x,bt_parse_t(f,bt_inputs())); }
            else { out=bt_predict(p,x); }
            if len(out)==0 { btx_error(text_concat("invalid input or nonfinite result at line ",int_text(row+1))); }
