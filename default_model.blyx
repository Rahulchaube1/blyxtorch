        btx_pull(d2, p, 12, 4, 2)*btx_tanh_slope(at(a1, 2)),
        btx_pull(d2, p, 12, 4, 3)*btx_tanh_slope(at(a1, 3))
    ];
    let gradient = [cost, at(d1,0)*at(a0,0), at(d1,0)*at(a0,1), at(d1,1)*at(a0,0), at(d1,1)*at(a0,1), at(d1,2)*at(a0,0), at(d1,2)*at(a0,1), at(d1,3)*at(a0,0), at(d1,3)*at(a0,1), at(d1,0), at(d1,1), at(d1,2), at(d1,3)
, at(d2,0)*at(a1,0), at(d2,0)*at(a1,1), at(d2,0)*at(a1,2), at(d2,0)*at(a1,3), at(d2,0)
];
    if !btx_valid(gradient,bt_parameters()+1) { return []; }
