use std::buffer;
use std::cli;
use std::text;
use std::fs;
use tensor_ops;
use convolution;
use transformer;
use embedding;
use numeric_io;

fn checkpoint(rows: i64, width: i64, table: vector) {
    print!("BTEMB1,"); print!(rows); print!(","); println!(width);
    let mut i = 0;
    while i < len(table) {
        print!(at(table,i)); print!(","); print!(at(table,i+1));
        let mut c = 0;
        while c < width { print!(","); print!(at(table,i+2+c)); c += 1; }
        println!();
        i += width+2;
    }
}
fn load_rows(lines: arglist, rows: i64, width: i64) -> vector {
    let records = args_len(lines)-1;
    bt_require(records <= rows, "too many embedding rows");
    let stride = bt_total(width,2);
    let mut table = buffer_fill(bt_size(records,stride),0.0);
    // The index exists only during validation. Preserve the original checkpoint order.
    let capacity = bt_total(bt_size(2,records),1);
    let mut high_keys = buffer_fill(capacity,-1.0);
    let mut low_keys = buffer_fill(capacity,0.0);
    let mut i = 1;
    while i < args_len(lines) {
        let fields = text_split(args_at(lines,i),",");
        bt_require(args_len(fields) == bt_total(2,width), "malformed embedding checkpoint row");
        let hi = natural(args_at(fields,0));
        let lo = natural(args_at(fields,1));
        bt_require(lo < 1000000000, "invalid embedding key");
        let id = bt_total(bt_size(hi,1000000000),lo);
        bt_require(id < rows, "invalid embedding row");
        let high = bt_as_float(hi);
        let low = bt_as_float(lo);
        let mut slot = (hi*1000003+lo) % capacity;
        while at(high_keys,slot) >= 0.0 {
            bt_require(at(high_keys,slot) != high || at(low_keys,slot) != low, "duplicate embedding row");
            slot = (slot+1) % capacity;
        }
        high_keys = buffer_set(high_keys,slot,high);
        low_keys = buffer_set(low_keys,slot,low);
        let base = (i-1)*stride;
        table = buffer_set(table,base,high);
        table = buffer_set(table,base+1,low);
        let mut c = 0;
        while c < width {
            let field = args_at(fields,2+c);
            bt_require(text_is_number(field), "expected a finite embedding value");
            table = buffer_set(table,base+2+c,text_number(field));
            c += 1;
        }
        i += 1;
    }
    table
}
// An SGD training run for a shared three-tap filter and a causal transformer.
fn demo() {
    let signal = [1,2,0,-1,3,1];
    let target = [1.25,-0.75,0.75,1.75];
    let mut filter = [0,0,0,0];
    let mut step = 0;
    while step <= 60 {
        let y = bt_conv1d(signal,6,1,1,3,1,0,filter);
        let mut error = buffer_fill(4,0.0);
        let mut i = 0;
        while i < 4 { error = buffer_set(error,i,at(y,i)-at(target,i)); i += 1; }
        if step == 0 || step == 60 { print!("conv1d loss "); println!(dot(error,error)/8.0); }
        if step < 60 {
            let grad = bt_conv1d_backward(signal,6,1,1,3,1,0,filter,error);
            filter = bt_sgd_step(filter,bt_slice(grad,6,4),0.04);
        }
        step += 1;
    }
    let x = [0.2,0.5,-0.3,0.8,0.1,-0.7,0.3,0.6,-0.4,0.2,0.9,0.1];
    let mut p = bt_transformer_init(4,8,107);
    step = 0;
    while step <= 40 {
        let y = bt_transformer(x,3,4,2,8,true,p);
        if step == 0 || step == 40 { print!("transformer loss "); println!(dot(y,y)/24.0); }
        if step < 40 {
            let grad = bt_transformer_backward(x,3,4,2,8,true,p,y);
            p = bt_sgd_step(p,bt_slice(grad,12,len(p)),0.004);
        }
        step += 1;
    }
}
pub fn bt_layer_command(args: arglist) -> bool {
    if args_len(args) == 0 { return false; }
    let cmd = args_at(args,0);
    if cmd == "layer-demo" {
        bt_require(args_len(args) == 1, "usage: blyxtorch layer-demo");
        demo(); return true;
    }
    if cmd == "transformer-plan" {
        bt_require(args_len(args) == 6, "usage: transformer-plan LAYERS WIDTH HEADS FEED_FORWARD VOCAB");
        let depth = natural(args_at(args,1));
        let width = natural(args_at(args,2));
        let heads = natural(args_at(args,3));
        let hidden = natural(args_at(args,4));
        let vocab = natural(args_at(args,5));
        bt_require(depth > 0 && heads > 0 && width > 0 && width % heads == 0, "invalid transformer plan dimensions");
        let block = bt_transformer_count(width,hidden);
        let embeddings = bt_embedding_count(vocab,width);
        let total = bt_total(bt_total(bt_size(depth,block),embeddings),bt_size(2,width));
        let bytes = bt_size(total,8);
        print!("{\"block_parameters\":"); print!(block);
        print!(",\"embedding_parameters\":"); print!(embeddings);
        print!(",\"total_parameters\":"); print!(total);
        print!(",\"dense_fp64_weight_bytes\":"); print!(bytes); println!("}");
        return true;
    }
    if cmd == "embedding-init" {
        bt_require(args_len(args) == 3, "usage: blyxtorch embedding-init ROWS WIDTH");
        let rows = natural(args_at(args,1));
        let width = natural(args_at(args,2));
        bt_embedding_count(rows,width);
        checkpoint(rows,width,[]); return true;
    }
    if cmd == "embedding-step" || cmd == "embedding-get" {
        bt_require((cmd == "embedding-get" && args_len(args) == 3) || (cmd == "embedding-step" && args_len(args) == 5), "usage: embedding-get FILE ROW | embedding-step FILE ROW RATE GRADIENT_CSV");
        let lines = text_lines(read_text(args_at(args,1)));
        bt_require(args_len(lines) > 0, "empty embedding checkpoint");
        let header = text_split(args_at(lines,0),",");
        bt_require(args_len(header) == 3 && args_at(header,0) == "BTEMB1", "invalid embedding checkpoint header");
        let rows = natural(args_at(header,1));
        let width = natural(args_at(header,2));
        bt_embedding_count(rows,width);
        let table = load_rows(lines,rows,width);
        let id = natural(args_at(args,2));
        if cmd == "embedding-get" { println!(bt_embedding_lookup(table,rows,width,id)); return true; }
        let rate = args_at(args,3);
        bt_require(text_is_number(rate), "invalid learning rate");
        let gradient = numbers(text_split(args_at(args,4),","),0,width);
        checkpoint(rows,width,bt_embedding_sgd(table,rows,width,id,gradient,text_number(rate)));
        return true;
    }
    false
}
